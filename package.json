{
  "name": "paid-admissions-dashboard-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "lint": "eslint .",
    "test": "pnpm run test:unit && pnpm run test:python",
    "test:unit": "vitest run src",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:e2e": "playwright test",
    "check:privacy": "node scripts/check-public-privacy.mjs",
    "check": "pnpm run lint && pnpm run test && pnpm run check:privacy && pnpm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.55.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "vitest": "4.0.18"
  }
}
